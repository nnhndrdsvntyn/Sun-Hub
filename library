local library = {}

local themes = {
    Dark = {
        BackgroundColor = Color3.fromRGB(40, 40, 40),
        TitleBackgroundColor = Color3.fromRGB(20, 20, 20),
        TitleTextColor = Color3.fromRGB(255, 255, 255),
        TabBackgroundColor = Color3.fromRGB(30, 30, 30),
        ContentBackgroundColor = Color3.fromRGB(50, 50, 50)
    },
    Light = {
        BackgroundColor = Color3.fromRGB(220, 220, 220),
        TitleBackgroundColor = Color3.fromRGB(200, 200, 200),
        TitleTextColor = Color3.fromRGB(0, 0, 0),
        TabBackgroundColor = Color3.fromRGB(190, 190, 190),
        ContentBackgroundColor = Color3.fromRGB(210, 210, 210)
    }
}

local currentTheme = themes.Dark

function library.setTheme(themeName)
    currentTheme = themes[themeName] or currentTheme
end

function library.getTheme()
    return currentTheme
end

-- Create UI ScreenGui
function library.createScreenGui()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
    return screenGui
end

function library.createFrame(parent, size, position, bgColor)
    local frame = Instance.new("Frame")
    frame.Size = size
    frame.Position = position
    frame.BackgroundColor3 = bgColor
    frame.Parent = parent
    frame.ClipsDescendants = true

    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 5)
    uiCorner.Parent = frame

    return frame
end

function library.createButton(parent, size, position, text, callback)
    local button = Instance.new("TextButton")
    button.Size = size
    button.Position = position
    button.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    button.Text = text
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Parent = parent

    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 5)
    uiCorner.Parent = button

    button.MouseButton1Click:Connect(callback)
end

function library.createDropdown(parent, options, callback)
    local dropdown = Instance.new("Frame")
    dropdown.Size = UDim2.new(0, 150, 0, 30)
    dropdown.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    dropdown.Parent = parent

    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 5)
    uiCorner.Parent = dropdown

    local selectedLabel = Instance.new("TextLabel")
    selectedLabel.Size = UDim2.new(1, -30, 1, 0)
    selectedLabel.Position = UDim2.new(0, 0, 0, 0)
    selectedLabel.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    selectedLabel.Text = options[1]
    selectedLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    selectedLabel.Parent = dropdown

    local uiCornerLabel = Instance.new("UICorner")
    uiCornerLabel.CornerRadius = UDim.new(0, 5)
    uiCornerLabel.Parent = selectedLabel

    local arrow = Instance.new("TextButton")
    arrow.Size = UDim2.new(0, 30, 1, 0)
    arrow.Position = UDim2.new(1, -30, 0, 0)
    arrow.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    arrow.Text = "▼"
    arrow.TextColor3 = Color3.fromRGB(255, 255, 255)
    arrow.Parent = dropdown

    local uiCornerArrow = Instance.new("UICorner")
    uiCornerArrow.CornerRadius = UDim.new(0, 5)
    uiCornerArrow.Parent = arrow

    local dropdownList = Instance.new("Frame")
    dropdownList.Size = UDim2.new(1, 0, #options, 30)
    dropdownList.Position = UDim2.new(0, 0, 1, 0)
    dropdownList.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    dropdownList.Visible = false
    dropdownList.Parent = dropdown

    local uiCornerList = Instance.new("UICorner")
    uiCornerList.CornerRadius = UDim.new(0, 5)
    uiCornerList.Parent = dropdownList

    for i, option in ipairs(options) do
        local optionButton = Instance.new("TextButton")
        optionButton.Size = UDim2.new(1, 0, 0, 30)
        optionButton.Position = UDim2.new(0, 0, (i - 1) * 30, 0)
        optionButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        optionButton.Text = option
        optionButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        optionButton.Parent = dropdownList

        local uiCornerOption = Instance.new("UICorner")
        uiCornerOption.CornerRadius = UDim.new(0, 5)
        uiCornerOption.Parent = optionButton

        optionButton.MouseButton1Click:Connect(function()
            selectedLabel.Text = option
            dropdownList.Visible = false
            callback(option)
        end)
    end

    arrow.MouseButton1Click:Connect(function()
        dropdownList.Visible = not dropdownList.Visible
    end)
end

return library
