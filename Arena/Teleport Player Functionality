-- Services
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Stores the selected player (starts as nil)
getgenv().SelectedPlayer = nil

-- Function to get a list of all players excluding the local player
getgenv().GetPlayerList = function()
    local playerNames = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(playerNames, player.Name)
        end
    end
    return playerNames
end

-- Function to teleport the player
getgenv().TeleportToSelectedPlayer = function()
    if not getgenv().SelectedPlayer then return end

    local TargetPlayer = Players:FindFirstChild(getgenv().SelectedPlayer)

    if TargetPlayer and TargetPlayer.Character and TargetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local LocalRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

        if LocalRoot then
            LocalRoot.CFrame = TargetPlayer.Character.HumanoidRootPart.CFrame
        end
    end
end

-- Function to manually refresh dropdown values
getgenv().RefreshTeleportDropdown = function()
    if getgenv().SelectTeleportPlayerDropdown then
        getgenv().SelectTeleportPlayerDropdown:Refresh(getgenv().GetPlayerList())
    end
end
