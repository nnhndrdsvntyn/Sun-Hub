-- Function to add rounded corners to an element
local function addRoundedCorners(element, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius)
    corner.Parent = element
end

-- Function to switch between tabs
local function switchTab(tabName, contentFrames)
    -- Hide all tab contents
    for _, content in pairs(contentFrames) do
        content.Visible = false
    end
    
    -- Show the selected tab's content
    local activeTab = contentFrames[tabName]
    if activeTab then
        activeTab.Visible = true
    end
end

-- Function to create a button and add it to a tab
local function AddButton(tabContent, buttonData)
    -- Create the button
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 50)  -- Full width, 50px height
    button.Position = UDim2.new(0, 0, 1, -50)  -- Place at the bottom of the tab
    button.BackgroundColor3 = Color3.fromRGB(70, 130, 180)
    button.Text = ""
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Font = Enum.Font.SourceSansBold
    button.TextSize = 22
    button.Parent = tabContent
    addRoundedCorners(button, 10)

    -- Title above the button
    local buttonTitle = Instance.new("TextLabel")
    buttonTitle.Size = UDim2.new(1, 0, 0, 30)
    buttonTitle.Position = UDim2.new(0, 10, 0, 0)
    buttonTitle.BackgroundTransparency = 1
    buttonTitle.Text = buttonData.Title
    buttonTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    buttonTitle.Font = Enum.Font.SourceSansBold
    buttonTitle.TextSize = 18
    buttonTitle.TextXAlignment = Enum.TextXAlignment.Left
    buttonTitle.Parent = tabContent
    addRoundedCorners(buttonTitle, 10)

    -- Description under the title
    local buttonDescription = Instance.new("TextLabel")
    buttonDescription.Size = UDim2.new(1, 0, 0, 20)
    buttonDescription.Position = UDim2.new(0, 10, 0, 30)
    buttonDescription.BackgroundTransparency = 1
    buttonDescription.Text = buttonData.Description
    buttonDescription.TextColor3 = Color3.fromRGB(200, 200, 200)
    buttonDescription.Font = Enum.Font.SourceSans
    buttonDescription.TextSize = 14
    buttonDescription.TextXAlignment = Enum.TextXAlignment.Left
    buttonDescription.Parent = tabContent
    addRoundedCorners(buttonDescription, 10)

    -- Button click function
    button.MouseButton1Click:Connect(buttonData.Function)
end

-- Define the function to initialize tabs (user provides tabs info)
local function initializeTabs()
    local contentFrames = {}

    -- Dynamically create content frames for each tab
    -- This is called after the user defines the tabs
    -- contentFrames will be populated when users call `initializeTabs`
    return {
        switchTab = function(tabName)
            switchTab(tabName, contentFrames)
        end,
        AddButton = function(tabName, buttonData)
            AddButton(contentFrames[tabName], buttonData)
        end,
        -- Placeholder for tabs, should be populated by the user when calling this function
        contentFrames = contentFrames
    }
end
