local function createToggle(name)
   getgenv().VoidBringMoves[name] = getgenv().VoidBringMoves[name] or false

   return Exploits_Tab:CreateToggle({
      Name = "Void Bring On " .. name,
      CurrentValue = getgenv().VoidBringMoves[name],
      Flag = "VoidBringMoves_" .. name,
      Callback = function(Value)
         getgenv().VoidBringMoves[name] = Value
      end,
   })
end

-- Creating toggles for each move
for name, _ in pairs(animations) do
   createToggle(name)
end

