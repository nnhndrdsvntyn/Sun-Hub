-- Load UI Framework
local SunHub_TSBG_MainArena = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Create UI Window
local Window = SunHub_TSBG_MainArena:CreateWindow({
   Name = "Sun Hub TSBG",
   Icon = 0,
   LoadingTitle = "Loading Sun Hub",
   LoadingSubtitle = "For TSBG",
   Theme = "Default",
   DisableRayfieldPrompts = false,
   DisableBuildWarnings = false,
   ConfigurationSaving = {
      Enabled = true,
      FolderName = nil,
      FileName = "Big Hub"
   },
   Discord = {
      Enabled = false,
      Invite = "noinvitelink",
      RememberJoins = true
   },
   KeySystem = false
})

-- UI Elements
local MainTab = Window:CreateTab("Main", 4483362458)
local VoidKillSection = MainTab:CreateSection("Void Kill")

-- Persistent selected moves storage
getgenv().SelectedMovesFlag = getgenv().SelectedMovesFlag or {}

-- Create status label
local VoidKillMovesDropdownStateLabel = MainTab:CreateLabel(
   "Void Kill Status: OFF",
   4483362458,
   Color3.fromRGB(255, 0, 0),
   true
)

-- Create dropdown
local VoidKillMovesDropdown = MainTab:CreateDropdown({
   Name = "Void Kill (Moves)",
   Options = {
      "Flowing Water", "Lethal Whirlwind Stream", "Foul Ball",
      "Atmos Cleave", "Pinpoint Cut", "Crushing Pull",
      "Bullet Barrage", "Head First"
   },
   CurrentOption = getgenv().SelectedMovesFlag, -- Persist selection after respawn
   MultipleOptions = true,
   Flag = "VoidKillMovesDropdown1",
   Callback = function(Options)
       if type(Options) ~= "table" then
           warn("Dropdown Callback Error: Options is not a table!")
           return
       end

       getgenv().SelectedMovesFlag = Options -- Save selections globally

       getgenv().UpdateSelectedMoves(Options) -- Call function from Void Kill Script

       if #Options > 0 then
           local selectedMoves = "[" .. table.concat(Options, "], [") .. "]"
           VoidKillMovesDropdownStateLabel:Set(
               "Void Kill Status: ON { Moves Selected: " .. selectedMoves .. " }",
               4483362458,
               Color3.fromRGB(0, 255, 0),
               true
           )
       else
           VoidKillMovesDropdownStateLabel:Set(
               "Void Kill Status: OFF",
               4483362458,
               Color3.fromRGB(255, 0, 0),
               true
           )
       end
   end,
})

-- Load Void Kill Script & Handle Errors
local function LoadVoidKillScript()
    local success, err = pcall(function()
        loadstring(game:HttpGet('https://raw.githubusercontent.com/nnhndrdsvntyn/Sun-Hub/refs/heads/Sun-Hub/Arena/Load%20Void%20Kill%20Functionality'))()
    end)

    if success then
        print("✅ Void Kill Script Loaded Successfully!")
    else
        warn("❌ Failed to Load Void Kill Script:", err)
    end
end

LoadVoidKillScript() -- Initial Load

-- Ensure Void Kill Script Works After Respawn
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

LocalPlayer.CharacterAdded:Connect(function()
    wait(0.5) -- Small delay to ensure everything loads

    -- Reset dropdown to none selected when dying
    VoidKillMovesDropdown:Set(nil)

    wait(0.5) -- Small delay before restoring selections

    -- Restore previous selection
    VoidKillMovesDropdown:Set(getgenv().SelectedMovesFlag)

    -- Reload Void Kill Script
    LoadVoidKillScript()

    -- Restore Void Kill moves automatically
    getgenv().UpdateSelectedMoves(getgenv().SelectedMovesFlag)
end)
