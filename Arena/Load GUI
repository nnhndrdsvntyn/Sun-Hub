-- UI Library
local UILibrary = {}

-- Create the ScreenGui (internal handling, no user input)
local function CreateScreen()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
    return screenGui
end

-- Create the window with pre-defined size (internal handling)
local function CreateWindow(screenGui)
    local window = Instance.new("Frame")
    window.Size = UDim2.new(0, 500, 0, 400) -- Fixed size window
    window.Position = UDim2.new(0.5, -250, 0.5, -200) -- Centered on screen
    window.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    window.Parent = screenGui

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 50)
    title.BackgroundTransparency = 1
    title.Text = "My Custom Window"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 24
    title.TextAlignment = Enum.TextAlignment.Center
    title.Parent = window

    return window
end

-- Create Tab System (internal handling)
local function CreateTabSystem(window)
    local tabBar = Instance.new("Frame")
    tabBar.Size = UDim2.new(0, 120, 1, 0)
    tabBar.Position = UDim2.new(0, 0, 0, 50)
    tabBar.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    tabBar.Parent = window

    local contentFrame = Instance.new("Frame")
    contentFrame.Size = UDim2.new(0, window.Size.X.Offset - 120, 1, 0)
    contentFrame.Position = UDim2.new(0, 120, 0, 50)
    contentFrame.BackgroundTransparency = 1
    contentFrame.Parent = window

    local tabs = {}

    local function AddTab(tabName, tabLabel)
        local tabButton = Instance.new("TextButton")
        tabButton.Size = UDim2.new(1, 0, 0, 50)
        tabButton.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        tabButton.Text = tabLabel
        tabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        tabButton.Font = Enum.Font.SourceSansBold
        tabButton.TextSize = 20
        tabButton.Parent = tabBar

        local tabContent = Instance.new("Frame")
        tabContent.Size = UDim2.new(1, 0, 1, 0)
        tabContent.Position = UDim2.new(0, 0, 0, 0)
        tabContent.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        tabContent.Visible = false
        tabContent.Parent = contentFrame

        tabs[tabName] = {
            button = tabButton,
            content = tabContent
        }

        tabButton.MouseButton1Click:Connect(function()
            for _, tab in pairs(tabs) do
                tab.content.Visible = false
            end
            tabContent.Visible = true
        end)
    end

    return { AddTab = AddTab, tabs = tabs }
end

-- Add button to a tab (internal handling)
local function AddButtonToTab(tabName, buttonData, tabSystem)
    local tab = tabSystem.tabs[tabName]
    if tab then
        local button = Instance.new("TextButton")
        button.Size = UDim2.new(1, 0, 0, 50)
        button.BackgroundColor3 = Color3.fromRGB(70, 130, 180)
        button.Text = buttonData.Title
        button.TextColor3 = Color3.fromRGB(255, 255, 255)
        button.Font = Enum.Font.SourceSansBold
        button.TextSize = 22
        button.Parent = tab.content

        local description = Instance.new("TextLabel")
        description.Size = UDim2.new(1, 0, 0, 20)
        description.Position = UDim2.new(0, 0, 1, 0)
        description.BackgroundTransparency = 1
        description.Text = buttonData.Description
        description.TextColor3 = Color3.fromRGB(200, 200, 200)
        description.Font = Enum.Font.SourceSans
        description.TextSize = 14
        description.Parent = tab.content

        button.MouseButton1Click:Connect(buttonData.Function)
    end
end

-- Main Initialization (hidden to the user)
function UILibrary:Init()
    local screenGui = CreateScreen()
    local window = CreateWindow(screenGui)
    local tabSystem = CreateTabSystem(window)

    -- Public functions (user-facing)
    function UILibrary:AddTab(tabName, tabLabel)
        tabSystem.AddTab(tabName, tabLabel)
    end

    function UILibrary:AddButton(tabName, buttonData)
        AddButtonToTab(tabName, buttonData, tabSystem)
    end
end

return UILibrary
