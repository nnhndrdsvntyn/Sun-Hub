-- Function to create a new slider
local function createSlider(name, size, position, parent, onValueChange)
    local sliderFrame = Instance.new("Frame")
    sliderFrame.Name = name
    sliderFrame.Size = size
    sliderFrame.Position = position
    sliderFrame.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    sliderFrame.Parent = parent
    addRoundedCorners(sliderFrame, 10)

    local slider = Instance.new("TextButton")
    slider.Name = "Slider"
    slider.Size = UDim2.new(1, -20, 0, 20)
    slider.Position = UDim2.new(0, 10, 0, 10)
    slider.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    slider.Text = ""
    slider.BorderSizePixel = 0
    slider.AutoButtonColor = false
    slider.ClipsDescendants = true
    slider.Parent = sliderFrame
    addRoundedCorners(slider, 10)

    local sliderFill = Instance.new("Frame")
    sliderFill.Name = "SliderFill"
    sliderFill.Size = UDim2.new(0.5, 0, 1, 0)  -- Initial size, adjust the value as needed
    sliderFill.Position = UDim2.new(0, 0, 0, 0)
    sliderFill.BackgroundColor3 = Color3.fromRGB(70, 130, 180)
    sliderFill.BorderSizePixel = 0
    sliderFill.Parent = slider

    local sliderHandle = Instance.new("Frame")
    sliderHandle.Name = "SliderHandle"
    sliderHandle.Size = UDim2.new(0, 10, 1, 0)
    sliderHandle.Position = UDim2.new(0.5, 0, 0, 0)  -- Initial position, adjust the value as needed
    sliderHandle.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    sliderHandle.BorderSizePixel = 0
    sliderHandle.Parent = slider
    addRoundedCorners(sliderHandle, 10)

    local draggingSlider = false

    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSlider = true
            local delta = input.Position.X - slider.AbsolutePosition.X
            local newPos = math.clamp(delta / slider.AbsoluteSize.X, 0, 1)
            sliderHandle.Position = UDim2.new(newPos, 0, 0, 0)
            sliderFill.Size = UDim2.new(newPos, 0, 1, 0)
            onValueChange(newPos)
        end
    end)

    slider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSlider = false
        end
    end)

    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position.X - slider.AbsolutePosition.X
            local newPos = math.clamp(delta / slider.AbsoluteSize.X, 0, 1)
            sliderHandle.Position = UDim2.new(newPos, 0, 0, 0)
            sliderFill.Size = UDim2.new(newPos, 0, 1, 0)
            onValueChange(newPos)
        end
    end)

    return sliderFrame
end

-- Function to create a new toggle
local function createToggle(name, size, position, parent, onToggle)
    local toggleFrame = Instance.new("Frame")
    toggleFrame.Name = name
    toggleFrame.Size = size
    toggleFrame.Position = position
    toggleFrame.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    toggleFrame.Parent = parent
    addRoundedCorners(toggleFrame, 10)

    local toggle = Instance.new("TextButton")
    toggle.Name = "Toggle"
    toggle.Size = UDim2.new(0, 40, 0, 40)  -- Square button
    toggle.Position = UDim2.new(0, 10, 0, 5)  -- Slightly from the left
    toggle.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    toggle.Text = ""
    toggle.BorderSizePixel = 0
    toggle.AutoButtonColor = false
    toggle.Parent = toggleFrame
    addRoundedCorners(toggle, 10)

    local toggleOn = false

    toggle.MouseButton1Click:Connect(function()
        toggleOn = not toggleOn
        if toggleOn then
            toggle.BackgroundColor3 = Color3.fromRGB(70, 130, 180)
        else
            toggle.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
        end
        onToggle(toggleOn)
    end)

    return toggleFrame
end

