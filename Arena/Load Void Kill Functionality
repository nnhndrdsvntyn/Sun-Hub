-- Load required services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = game.Workspace.CurrentCamera

-- Variables
local DetectionHalted = false
local Platform
local OriginalPosition
local TargetY = -497.9
local PlatformY = -499.9
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")

-- Animation data
local Animations = {
    ["Flowing Water"] = {id = "12273188754", delay = 0.85, duration = 2},
    ["Lethal Whirlwind Stream"] = {id = "12296113986", delay = 1, duration = 1.5},
    ["Foul Ball"] = {id = "14705929107", delay = 1.75, duration = 1.5},
    ["Atmos Cleave"] = {id = "15145462680", delay = 1.75, duration = 2},
    ["Pinpoint Cut"] = {id = "15295895753", delay = 0.85, duration = 2},
    ["Crushing Pull"] = {id = "16139108718", delay = 0.00000000000000000000000000000000001, duration = 1.3},
    ["Bullet Barrage"] = {id = "17799224866", delay = 2, duration = 2.5},
    ["Head First"] = {id = "18182425133", delay = 1.5, duration = 4}
}

-- Selected moves storage
getgenv().SelectedMovesFlag = {}

-- Utility Functions
local function isAnimationPlaying(animationName)
    if Character and Character:FindFirstChild("Humanoid") then
        for _, track in ipairs(Character.Humanoid:GetPlayingAnimationTracks()) do
            if track.Animation and track.Animation.AnimationId == "rbxassetid://" .. Animations[animationName].id then
                return true
            end
        end
    end
    return false
end

local function freezeCamera()
    Camera.CameraType = Enum.CameraType.Scriptable
end

local function unfreezeCamera()
    Camera.CameraType = Enum.CameraType.Custom
end

local function teleportPlayer(position)
    if Character and Character.PrimaryPart then
        Character:SetPrimaryPartCFrame(CFrame.new(position))
    end
end

local function createTrackingPlatform()
    Platform = Instance.new("Part")
    Platform.Size = Vector3.new(100, 1, 100)
    Platform.Position = Vector3.new(Character.PrimaryPart.Position.X, PlatformY, Character.PrimaryPart.Position.Z)
    Platform.Anchored = true
    Platform.CanCollide = true
    Platform.Parent = workspace

    local connection
    connection = RunService.Heartbeat:Connect(function()
        if Platform and Character and Character.PrimaryPart then
            Platform.Position = Vector3.new(Character.PrimaryPart.Position.X, PlatformY, Character.PrimaryPart.Position.Z)
        else
            connection:Disconnect()
        end
    end)
end

local function removePlatform()
    if Platform then
        Platform:Destroy()
        Platform = nil
    end
end

local function getAnimationData(move)
    return Animations[move]
end

-- Animation Detection Loop
RunService.RenderStepped:Connect(function()
    if #getgenv().SelectedMovesFlag > 0 then
        for _, move in ipairs(getgenv().SelectedMovesFlag) do
            local animationData = getAnimationData(move)

            if animationData and isAnimationPlaying(move) and not DetectionHalted then
                DetectionHalted = true

                task.wait(animationData.delay - 0.00001)
                OriginalPosition = Character.PrimaryPart.Position

                task.wait(0.00001)

                freezeCamera()
                createTrackingPlatform()
                teleportPlayer(Vector3.new(OriginalPosition.X, TargetY, OriginalPosition.Z))

                task.wait(animationData.duration)

                teleportPlayer(OriginalPosition)
                unfreezeCamera()
                removePlatform()

                DetectionHalted = false
            end
        end
    end
end)

-- Function to update moves (UI script will call this)
getgenv().UpdateSelectedMoves = function(moves)
    getgenv().SelectedMovesFlag = moves
end
