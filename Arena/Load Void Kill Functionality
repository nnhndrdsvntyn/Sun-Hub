if getgenv().VoidKillLoaded then return end
getgenv().VoidKillLoaded = true

local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

local function getCharacter()
   return localPlayer.Character or localPlayer.CharacterAdded:Wait()
end

local function voidKill()
   while getgenv().VoidKillEnabled do
      local character = getCharacter()
      local rootPart = character:FindFirstChild("HumanoidRootPart")
      if rootPart then
         rootPart.CFrame = CFrame.new(0, -500, 0) -- Teleport to void
      end
      task.wait(0.1) -- Adjust this for smoother behavior
   end
end

task.spawn(voidKill)

localPlayer.CharacterAdded:Connect(function()
   if getgenv().VoidKillEnabled then
      task.spawn(voidKill)
   end
end)
