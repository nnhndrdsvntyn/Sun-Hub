if getgenv().AntiDeathCounterLoaded then return end
getgenv().AntiDeathCounterLoaded = true

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

local function deleteDeathGUIs()
   local playerGui = localPlayer:FindFirstChild("PlayerGui")
   if playerGui then
      for _, gui in pairs(playerGui:GetChildren()) do
         if gui:IsA("ScreenGui") and gui.Name == "Death" then
            gui:Destroy()
         end
      end
   end
end

local function stopDeathAnimation()
   local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
   local humanoid = character:FindFirstChildWhichIsA("Humanoid")
   local animator = humanoid and humanoid:FindFirstChildWhichIsA("Animator")

   if animator then
      for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
         if track.Animation and track.Animation.AnimationId == "rbxassetid://11343250001" then
            track:Stop()
         end
      end
   end
end

local function preventDeath()
   while getgenv().AntiDeathCounterEnabled do
      stopDeathAnimation()
      deleteDeathGUIs()
      task.wait(0.1)
   end
end

task.spawn(preventDeath)

RunService.Heartbeat:Connect(function()
   if getgenv().AntiDeathCounterEnabled then
      preventDeath()
   end
end)
